[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/GUI/avatar_preview.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/GUI/avatar_stage.tscn" id="2_stage"]
[ext_resource type="Texture2D" path="res://themes/icons/folder.svg" id="3_folder"]
[ext_resource type="Texture2D" path="res://themes/icons/frame.svg" id="4_frame"]
[ext_resource type="Texture2D" path="res://themes/icons/reset.svg" id="5_reset"]
[ext_resource type="Texture2D" path="res://themes/icons/emote.svg" id="6_idle"]

[node name="AvatarPreview" type="PanelContainer"]
custom_minimum_size = Vector2(120, 180)
theme_type_variation = &"PreviewStage"
script = ExtResource("1")

[node name="StageContainer" parent="." instance=ExtResource("2_stage")]
unique_name_in_owner = true
layout_mode = 2

[node name="Overlay" type="CenterContainer" parent="."]
layout_mode = 2
mouse_filter = 2

[node name="Column" type="VBoxContainer" parent="Overlay"]
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
mouse_filter = 2
alignment = 1

[node name="Loading" type="ProgressBar" parent="Overlay/Column"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(100, 6)
layout_mode = 2
mouse_filter = 2
show_percentage = false

[node name="StatusLabel" type="Label" parent="Overlay/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "No avatar set."
horizontal_alignment = 1
autowrap_mode = 3

[node name="RetryButton" type="Button" parent="Overlay/Column"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 4
text = "Retry"

[node name="ToolbarAnchor" type="MarginContainer" parent="."]
layout_mode = 2
theme_type_variation = &"InsetMargin"
size_flags_horizontal = 8
size_flags_vertical = 0
mouse_filter = 2

[node name="Toolbar" type="HBoxContainer" parent="ToolbarAnchor"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"FlushHBox"

[node name="OpenFile" type="Button" parent="ToolbarAnchor/Toolbar"]
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
tooltip_text = "Open a local VRM file. Local preview only; the file is not uploaded."
theme_type_variation = &"IconButton"
icon = ExtResource("3_folder")
icon_alignment = 1

[node name="Framing" type="Button" parent="ToolbarAnchor/Toolbar"]
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
tooltip_text = "Frame: full body"
theme_type_variation = &"IconButton"
icon = ExtResource("4_frame")
icon_alignment = 1

[node name="ResetView" type="Button" parent="ToolbarAnchor/Toolbar"]
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
tooltip_text = "Reset view"
theme_type_variation = &"IconButton"
icon = ExtResource("5_reset")
icon_alignment = 1

[node name="Idle" type="Button" parent="ToolbarAnchor/Toolbar"]
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
tooltip_text = "Show relaxed pose"
theme_type_variation = &"IconButton"
toggle_mode = true
icon = ExtResource("6_idle")
icon_alignment = 1
